# ---------------------------------------------------------------
# Biz Reborn Marketing — environment configuration
# Copy to .env.local and fill in your own values.
#
# The app runs fully in DEMO MODE without these keys (perfect for
# previewing the funnel end-to-end). Add Supabase + Stripe keys to
# switch to live data and real payments.
# ---------------------------------------------------------------

# ----- App -----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: host your real VSL mp4 in /public and point at it.
# If unset, the player renders a cinematic animated demo preview.
NEXT_PUBLIC_VSL_SRC=/vsl.mp4

# ----- Supabase (Auth + Database) -----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----- Stripe (Payments) -----
# Public key powers the Elements card form.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhook`
STRIPE_WEBHOOK_SECRET=

# ----- MailerLite (Lead capture + autoresponder) -----
# New API token from MailerLite -> Integrations -> Developers.
MAILERLITE_API_KEY=
# Group id that owns your welcome / auto-responder sequence. Subscribers
# added here fire the automation. Leave empty to collect leads only.
MAILERLITE_GROUP_ID=

# ----- AI Chat (optional) -----
# Without this the chat runs on the built-in knowledge-base engine
# (all 100 services, 10 pillars, pricing, audit). Add a key to upgrade
# to an OpenAI-backed assistant that answers from the same knowledge base.
OPENAI_API_KEY=
CHAT_OPENAI_MODEL=gpt-4o-mini

# ----- Lead Generation module (audits + pitch videos, optional) -----
# All integrations fall back to deterministic mock data, so /admin/prospects
# works out of the box. Add keys/bins to enable the real pipeline:
# - Google Maps scraping: install `playwright` + browsers (or set mock).
# - Pitch script: free Google Gemini via GEMINI_API_KEY (default model gemini-3.1-flash-lite).
# - Voiceover: python3 + `pip install edge-tts` (or set mock).
# - Video render: `remotion` + Chrome + FFmpeg (or set mock).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
SCRAPER_MODE=auto           # auto | playwright | mock
TTS_MODE=auto               # auto | edge-tts | mock
VIDEO_MODE=auto             # auto | remotion | mock
LEADGEN_EMAIL=bizrebornmarketing@gmail.com

# ----- Multi-channel video outreach (IG DM / Messenger / WhatsApp / TikTok) -----
# Every channel is optional. Unconfigured channels fail fast with a clear
# error in outreach_logs rather than pretending a message was delivered.
# Meta Graph (Instagram + Facebook Messenger). IG DMs use the Facebook Page
# that owns the IG account as the sender.
META_GRAPH_VERSION=v23.0
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# Optional multi-page map: {"1234567890":"EAAB…","9876543210":"EAAB…"}
META_PAGE_ACCESS_TOKENS=
# Messenger 24h-window policy: RESPONSE inside the window; outside it use an
# approved message tag (e.g. MESSAGE_TAG + POST_PURCHASE_UPDATE).
META_MESSAGING_TYPE=RESPONSE
META_MESSAGE_TAG=
META_DEFAULT_THUMBNAIL_URL=
# Graph messaging needs IGSIDs/PSIDs, not @handles. Map known leads here:
# {"@thehandle":"1234567890"} — webhooks fill in the id for inbound leads.
INSTAGRAM_HANDLE_TO_ID=
FACEBOOK_HANDLE_TO_ID=

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# First-touch outreach outside the 24h window requires an approved template.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en_US
# Pipe-separated body variables, e.g. {leadName}|{businessName}|{videoUrl}
WHATSAPP_TEMPLATE_BODY_PARAMS=
WHATSAPP_TEMPLATE_URL_BUTTON=0
WHATSAPP_TEMPLATE_HEADER_IMAGE=0

# TikTok Business messaging: set the approved API endpoint, or an automation
# webhook (Make/Zapier/n8n) that owns creator-inbox delivery.
TIKTOK_MESSAGING_API_URL=
TIKTOK_MESSAGING_WEBHOOK_URL=
TIKTOK_ACCESS_TOKEN=
TIKTOK_BUSINESS_ID=
TIKTOK_WEBHOOK_SECRET=
TIKTOK_AUTH_HEADER=Authorization
TIKTOK_AUTH_SCHEME=Bearer

# GoHighLevel v2 High-Intent Bridge
# POST /api/merit-bridge — trigger syncProspectToGhl(prospectId, eventType).
# Protected via x-merit-bridge-token header matching process.env.MERIT_BRIDGE_SECRET
# (fallback: process.env.SUPABASE_SERVICE_ROLE_KEY).
GHL_API_KEY=
GHL_LOCATION_ID=gCaqVjrA1RxKaQVXm7U1

# Optional: secret used by the bridge for token validation.
MERIT_BRIDGE_SECRET=

# GoHighLevel inbound webhook (tags contacts on sent/delivered/replied/failed)
GHL_WEBHOOK_URL=
GHL_WEBHOOK_SECRET=

# Optional cold-outreach bridge (browser extension / Make / n8n / Playwright).
# POST /api/outreach/manual { action: "bridge" } forwards queued IG/TikTok rows
# here; return { "id": "<provider message id>" } on success.
MANUAL_DM_BRIDGE_URL=
MANUAL_DM_BRIDGE_SECRET=
MANUAL_DM_BRIDGE_TIMEOUT_MS=15000

# Automatic cold-queue intake (run after the pitch video renders).
# OUTREACH_QUEUE_ON_READY=1 queues every rendered lead with a social/phone
# handle; set to 0 to keep the queue fully manual.
OUTREACH_QUEUE_ON_READY=1
# Manual-safe channels by default; add whatsapp only after template approval.
OUTREACH_QUEUE_CHANNELS=instagram,facebook,tiktok
# Optional city allow-list (case-insensitive substring match), e.g. local
# Treasure Coast + Space Coast sprint leads:
# OUTREACH_QUEUE_CITIES=Vero Beach,Fellsmere,Sebastian,Indian River Shores,Orchid,Wabasso,Fort Pierce,Port St. Lucie,Stuart,Palm Bay,Melbourne
OUTREACH_QUEUE_CITIES=
# Machine auth for local scraper batches POSTing to /api/outreach/queue.
SCRAPER_WEBHOOK_SECRET=

# Queue retry policy
MESSAGING_MAX_ATTEMPTS=3
MESSAGING_RETRY_BASE_MS=60000
MESSAGING_SEND_TIMEOUT_MS=15000
