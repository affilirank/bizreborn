# ---------------------------------------------------------------
# Biz Reborn Marketing — environment configuration
# Copy to .env.local and fill in your own values.
#
# The app runs fully in DEMO MODE without these keys (perfect for
# previewing the funnel end-to-end). Add Supabase + Stripe keys to
# switch to live data and real payments.
# ---------------------------------------------------------------

# ----- App -----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: host your real VSL mp4 in /public and point at it.
# If unset, the player renders a cinematic animated demo preview.
NEXT_PUBLIC_VSL_SRC=/vsl.mp4

# ----- Supabase (Auth + Database) -----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----- Stripe (Payments) -----
# Public key powers the Elements card form.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhook`
STRIPE_WEBHOOK_SECRET=

# ----- MailerLite (Lead capture + autoresponder) -----
# New API token from MailerLite -> Integrations -> Developers.
MAILERLITE_API_KEY=
# Group id that owns your welcome / auto-responder sequence. Subscribers
# added here fire the automation. Leave empty to collect leads only.
MAILERLITE_GROUP_ID=

# ----- AI Chat (optional) -----
# Without this the chat runs on the built-in knowledge-base engine
# (all 100 services, 10 pillars, pricing, audit). Add a key to upgrade
# to an OpenAI-backed assistant that answers from the same knowledge base.
OPENAI_API_KEY=
CHAT_OPENAI_MODEL=gpt-5.4-mini

# ----- Lead Generation module (audits + pitch videos, optional) -----
# All integrations fall back to deterministic mock data, so /admin/prospects
# works out of the box. Add keys/bins to enable the real pipeline:
# - Google Maps scraping: install `playwright` + browsers (or set mock).
# - Pitch script: free Google Gemini via GEMINI_API_KEY (default model gemini-3.1-flash-lite).
# - Voiceover: python3 + `pip install edge-tts` (or set mock).
# - Video render: `remotion` + Chrome + FFmpeg (or set mock).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
SCRAPER_MODE=auto           # auto | playwright | mock
TTS_MODE=auto               # auto | edge-tts | mock
VIDEO_MODE=auto             # auto | remotion | mock
LEADGEN_EMAIL=bizrebornmarketing@gmail.com
