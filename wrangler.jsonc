{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bizreborn",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": ".open-next/assets",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "0 14 * * 1-5",
      "30 14 * * 1-5"
    ]
  }
}
